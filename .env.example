# 复制本文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库

# DeepSeek API Key（开放平台 https://platform.deepseek.com/ 创建）
DEEPSEEK_API_KEY=sk-your-api-key

# OpenAI 兼容接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-chat（默认）/ deepseek-v4-flash（更快更省）/ deepseek-reasoner（推理更强）
DEEPSEEK_MODEL=deepseek-chat
